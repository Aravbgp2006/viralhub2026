# ViralHub 2026 Environment Configuration

# Server Port (Local)
PORT=3000

# Neon PostgreSQL Database Connection String (Required for production on Vercel)
# Obtain this from your Neon Console (Dashboard -> Connection Details -> Connection String)
# Example: postgresql://neondb_owner:npg_xxxxxx@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=viralhub_2026_cms_secret_key_8f3a1b

# Vercel Blob Storage Token (Required for production uploads on Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
# Blob Store Access mode: 'private' (default) or 'public'
BLOB_ACCESS=private

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Razorpay Payment Link for ₹9 Unlock (Optional override: when provided, "Unlock Premium" opens this link)
RAZORPAY_PAYMENT_LINK_URL=https://rzp.io/rzp/xxxxxx

# Cashfree Sandbox Configuration (Separate Generic Test Payment Demo)
CASHFREE_APP_ID=TEST_APP_ID_HERE
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_HERE
CASHFREE_ENV=sandbox
